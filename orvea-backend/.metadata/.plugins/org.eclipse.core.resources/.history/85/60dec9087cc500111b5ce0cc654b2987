package com.hms.auth.service;

import java.time.LocalDateTime;

import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import com.hms.auth.dto.LoginRequest;
import com.hms.auth.dto.TokenResponse;
import com.hms.auth.entity.User;
import com.hms.auth.entity.UserSession;
import com.hms.auth.enums.SessionStatus;
import com.hms.auth.repository.UserRepository;
import com.hms.auth.repository.UserSessionRepository;
import com.hms.auth.util.UserMapper;
import com.hms.common.exception.BusinessException;
import com.hms.common.exception.ForbiddenException;
import com.hms.common.exception.UnauthorizedException;
import com.hms.common.security.AuthenticatedUser;
import com.hms.common.security.JwtProperties;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

@Service
@RequiredArgsConstructor
@Slf4j
public class AuthService {

	static final int MAX_FAILED_ATTEMPTS = 5;
	static final int LOCK_MINUTES = 15;

	private final PasswordEncoder passwordEncoder;
	private final JwtProperties jwtProperties;
	private final UserRepository userRepository;
	private final UserSessionRepository sessionRepository;

	// noRollbackFor: failed-attempt counters must be committed even when we throw
	@Transactional(noRollbackFor = BusinessException.class)
	public TokenResponse login(LoginRequest req, String ip, String userAgent) {
		User user = userRepository
				.findByUsernameIgnoreCaseOrEmailIgnoreCase(req.usernameOrEmail(), req.usernameOrEmail())
				.orElseThrow(() -> new UnauthorizedException("Invalid credentials"));

		LocalDateTime now = LocalDateTime.now();
		if (!user.isEnabled()) {
			throw new ForbiddenException("Account is disables");
		}
		if (user.getLockedUntil() != null && user.getLockedUntil().isAfter(now)) {
			throw new ForbiddenException("Account locked. Try again after " + user.getLockedUntil());
		}
		if (!passwordEncoder.matches(req.password(), user.getPasswordHash())) {
			registerFailure(user, now);
			throw new UnauthorizedException("Invalid credentials");
		}

		user.setFailedLoginAttempts(0);
		user.setLockedUntil(null);
		user.setLastLoginAt(now);

		UserSession session = new UserSession();
		session.setUser(user);
		session.setClinicId(user.getClinicId());
		session.setIpAddress(ip);
		session.setUserAgent(userAgent == null ? null : userAgent.substring(0, Math.min(255, userAgent.length())));
		session.setLoginAt(now);
		session.setLastAccessAt(now);
		session.setExpiresAt(now.plusNanos(jwtProperties.getRefreshTokenExpiryMs() * 1_000_000));
		session.setStatus(SessionStatus.ACTIVE);
		session = sessionRepository.saveAndFlush(session);
		return issueTokens(user, session);
	}

	// Helper Methods
	private void registerFailure(User user, LocalDateTime now) {
		int attempts = user.getFailedLoginAttempts() + 1;
		user.setFailedLoginAttempts(attempts);
		if (attempts >= MAX_FAILED_ATTEMPTS) {
			user.setLockedUntil(now.plusMinutes(LOCK_MINUTES));
			user.setFailedLoginAttempts(0);
			log.warn("User {} locked for {} minutes", user.getUsername(), LOCK_MINUTES);
		}
	}

	private TokenResponse issueTokens(User user, UserSession session) {
		String sid = session.getId().toString();
		AuthenticatedUser principal = new AuthenticatedUser(user.getId(), user.getUsername(), user.getClinicId(), sid,
				UserMapper.roleNames(user).stream().map(Enum::name).sorted().toList(),
				UserMapper.permissionNames(user));
		return null;
	}
}
