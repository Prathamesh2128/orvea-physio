package com.hms.auth.entity;

import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.List;

import org.hibernate.annotations.SQLRestriction;

import com.hms.auth.enums.SessionStatus;
import com.hms.common.entity.BaseEntity;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.EnumType;
import jakarta.persistence.Enumerated;
import jakarta.persistence.FetchType;
import jakarta.persistence.Index;
import jakarta.persistence.JoinColumn;
import jakarta.persistence.ManyToOne;
import jakarta.persistence.OneToMany;
import jakarta.persistence.Table;
import lombok.Getter;
import lombok.Setter;

@SuppressWarnings("serial")
@Getter
@Setter
@Entity
@Table(name = "user_sessions", indexes = @Index(name = "idx_session_user_status", columnList = "user_id, status"))
@SQLRestriction("is_deleted = false")
public class UserSession extends BaseEntity {
	@ManyToOne(fetch = FetchType.LAZY, optional = false)
	@JoinColumn(name = "user_id", nullable = false)
	private User user;

	@Column(length = 64)
	private String ipAddress;

	@Column(length = 255)
	private String userAgent;

	@Column(nullable = false)
	private LocalDateTime loginAt;

	private LocalDateTime lastAccessAt;

	@Column(nullable = false)
	private LocalDateTime expiresAt;

	@Column(length = 250)
	private String revokeReason;

	@Enumerated(EnumType.STRING)
	@Column(nullable = false, length = 20)
	private SessionStatus status;

	@OneToMany(mappedBy = "session", fetch = FetchType.LAZY)
	private List<RefreshToken> refreshToken = new ArrayList<>();
}
