package com.hms.auth.util;

import java.util.List;
import java.util.Set;
import java.util.stream.Collectors;

import com.hms.auth.dto.UserSummary;
import com.hms.auth.entity.Role;
import com.hms.auth.entity.User;
import com.hms.common.enums.RoleType;

public final class UserMapper {
	private UserMapper() {
	}

	public static Set<RoleType> roleNames(User u) {
		return u.getRoles().stream().map(Role::getName).collect(Collectors.toSet());
	}

	public static List<String> permissionNames(User u) {
		return u.getRoles().stream().flatMap(r -> r.getPermissions().stream()).map(p -> p.getName().name()).distinct()
				.sorted().toList();
	}

	public static UserSummary toSummary(User u) {
		List<RoleType> roles = u.getRoles().stream().map(Role::getName).sorted().toList();
	}
}
